<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#E6F6D20F"
                android:endColor="#E6D4AF37" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#EA121318"
                android:endColor="#EA1C1E26" />
            <stroke
                android:width="2dp"
                android:color="#F6D20F" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
