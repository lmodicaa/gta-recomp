<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#16171D"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌐 Conectar a Servidor MTA"
        android:textColor="#F6D20F"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Multi Theft Auto Android Client (v1.6 Core)"
        android:textColor="#808096"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <!-- Nickname Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="APODO / NICKNAME:"
        android:textColor="#B0B0C0"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etMtaNick"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="#22232B"
        android:textColor="#FFFFFF"
        android:textColorHint="#606070"
        android:hint="Ej. Player1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <!-- IP & Port row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP / HOST:"
                android:textColor="#B0B0C0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etMtaHost"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="#22232B"
                android:textColor="#FFFFFF"
                android:textColorHint="#606070"
                android:hint="127.0.0.1 o dominio"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="14sp"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PUERTO:"
                android:textColor="#B0B0C0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etMtaPort"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="#22232B"
                android:textColor="#FFFFFF"
                android:hint="22003"
                android:textColorHint="#606070"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="14sp"
                android:inputType="number"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Host Local Server Button -->
    <Button
        android:id="@+id/btnMtaHostLocal"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="👑 CREAR SERVIDOR LOCAL (HOST)"
        android:textColor="#4CC9F0"
        android:textStyle="bold"
        android:background="@drawable/btn_dark"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMtaCancel"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="CERRAR"
            android:textColor="#C0C0D0"
            android:background="@drawable/btn_dark"
            android:textSize="12sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnMtaConnect"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="CONECTAR"
            android:textColor="#000000"
            android:textStyle="bold"
            android:background="@drawable/btn_gold"
            android:textSize="12sp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
